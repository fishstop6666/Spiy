-- [[ สคริปต์: สปุ้ย (Sapui Hub) - Untitled Boxing Game ]] --

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "🥊 สปุ้ย Hub | Untitled Boxing Game",
   LoadingTitle = "กำลังโหลดสคริปต์ สปุ้ย...",
   LoadingSubtitle = "โดย สปุ้ย Developer",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "SapuiHub",
      FileName = "UntitledBoxing"
   },
   Discord = {
      Enabled = false
   },
   KeySystem = false -- ปิดระบบคีย์เพื่อให้ใช้งานได้ทันที
})

-- 변수 สำหรับตั้งค่า Auto Farm & Auto Dodge
local AutoDodge = false
local AutoPunch = false
local InfiniteStamina = false

-- แท็บหลัก
local MainTab = Window:CreateTab("ฟังก์ชันหลัก 🥊", 4483362458)

-- 1. ระบบหลบอัตโนมัติ (Auto Dodge / Auto Counter)
MainTab:CreateToggle({
   Name = "หลบหมัดอัตโนมัติ (Auto Dodge)",
   CurrentValue = false,
   Flag = "AutoDodgeToggle",
   Callback = function(Value)
      AutoDodge = Value
      task.spawn(function()
         while AutoDodge do
            task.wait(0.01)
            -- จำลองการกดปุ่มหลบเมื่อศัตรูเริ่มออกหมัด
            pcall(function()
               local character = game.Players.LocalPlayer.Character
               if character and character:FindFirstFound("Humanoid") then
                  -- ใส่ Event หรือ Keybind สำหรับการหลบในเกม
                  game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                  task.wait(0.05)
                  game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.Space, false, game)
               end
            end)
         end
      end)
   end,
})

-- 2. ระบบชกแม็กนัม/ชกอัตโนมัติ (Auto Punch)
MainTab:CreateToggle({
   Name = "ชกอัตโนมัติ (Auto Punch)",
   CurrentValue = false,
   Flag = "AutoPunchToggle",
   Callback = function(Value)
      AutoPunch = Value
      task.spawn(function()
         while AutoPunch do
            task.wait(0.1)
            pcall(function()
               -- จำลองการคลิกเมาส์ซ้ายเพื่อชก
               game:GetService("VirtualInputManager"):SendMouseButtonEvent(0, 0, 0, true, game, 0)
               task.wait(0.05)
               game:GetService("VirtualInputManager"):SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
         end
      end)
   end,
})

-- 3. สตามินาไม่จำกัด (Infinite Stamina / Anti-Stun)
MainTab:CreateToggle({
   Name = "สตามินาไม่หมด (Infinite Stamina)",
   CurrentValue = false,
   Flag = "InfStaminaToggle",
   Callback = function(Value)
      InfiniteStamina = Value
      task.spawn(function()
         while InfiniteStamina do
            task.wait(0.2)
            pcall(function()
               local player = game.Players.LocalPlayer
               if player.Character and player.Character:FindFirstChild("Stamina") then
                  player.Character.Stamina.Value = 100
               end
            end)
         end
      end)
   end,
})

-- แท็บปรับแต่งตัวละคร
local PlayerTab = Window:CreateTab("ตัวละคร 🏃", 4483362458)

-- ปรับความเร็วการเดิน
PlayerTab:CreateSlider({
   Name = "ความเร็วการเคลื่อนที่ (WalkSpeed)",
   Range = {16, 100},
   Increment = 1,
   Suffix = "Speed",
   CurrentValue = 16,
   Flag = "SpeedSlider",
   Callback = function(Value)
      if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
         game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
      end
   end,
})

-- แจ้งเตือนเมื่อโหลดสคริปต์เสร็จ
Rayfield:Notify({
   Title = "สปุ้ย Hub",
   Content = "โหลดสคริปต์สำเร็จแล้ว! พร้อมใช้งาน",
   Duration = 5,
   Image = 4483362458,
})
